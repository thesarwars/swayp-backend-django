DEBUG=True

SECRET_KEY=CHANGE_ME

POSTGRES_DB=swayp

POSTGRES_USER=postgres

POSTGRES_PASSWORD=saad5918

POSTGRES_HOST=localhost

POSTGRES_PORT=5432

ALLOWED_HOSTS=*

REDIS_URL=redis://localhost:6379/0

# Stripe. STRIPE_WEBHOOK_SECRET verifies inbound processor webhooks (E6-S8);
# the secret/publishable pair is for E9 billing. Use test-mode keys outside
# production — never commit real values, this file is tracked.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Cache. Defaults to REDIS_URL above; LocMem if neither is set. Must be shared
# across workers for the Flo daily call cap to be a real cap.
# CACHE_URL=redis://localhost:6379/1

# Providers (E1-S4). "mock" everywhere until each real provider's epic lands.
# BANK_DATA_PROVIDER=mock
# MONEY_MOVEMENT_PROVIDER=mock
# DIRECTORY_PROVIDER=mock
# CHECK_MAIL_PROVIDER=mock

# Flo, the AI cash advisor (E7).
# Off by default: a deterministic Python template sentence is served and no
# LLM call is made, so the feature works with no LLM account.
# FLO_LLM_ENABLED=False
# "template" (offline default) or "anthropic" (needs the key below, a signed
# DPA, and `pip install anthropic`).
# LLM_PROVIDER=template
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5
# FLO_LLM_DAILY_CAP=50
# Whole-call budget in seconds; on timeout the template is served.
# FLO_LLM_TIMEOUT_SECONDS=2.0

# How long a stored bank balance may be served before it is re-read (E5 -> E7).
# BALANCE_MAX_AGE_SECONDS=300

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@getswayp.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=noreply@getswayp.com
SERVER_EMAIL=noreply@getswayp.com
# --- Subscription billing (E9-S1) ---------------------------------------
# "mock" records entitlements and charges nothing; "stripe" collects money.
# Going live is swapping sk_test_/pk_test_ above for sk_live_/pk_live_.
SUBSCRIPTION_BILLING_PROVIDER=mock
# Stripe Billing signs with its own scheme, so it needs a secret separate
# from STRIPE_WEBHOOK_SECRET above. From the Dashboard endpoint for
# /webhooks/stripe/billing/, or from `stripe listen`.
STRIPE_BILLING_WEBHOOK_SECRET=whsec_CHANGE_ME

# Where emailed links point (E10-S2 team invites). The accept page is a
# frontend route, so the backend cannot derive this.
FRONTEND_URL=http://localhost:3000

# --- Production only ------------------------------------------------------
# config/settings/production.py refuses to boot without each of these. That is
# deliberate: a service that will not start gets fixed in ten minutes, one
# that starts with the development secret key does not get noticed.
DJANGO_SETTINGS_MODULE=config.settings.production

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME
# Comma-separated. Empty + DEBUG=False means Django rejects every request.
DJANGO_ALLOWED_HOSTS=api.getswayp.com
# Comma-separated scheme+host. Without it the frontend is blocked by CORS.
CORS_ALLOWED_ORIGINS=https://app.getswayp.com

# Set to 31536000 only once the domain and every subdomain serve HTTPS —
# browsers remember HSTS and it cannot be withdrawn quickly.
DJANGO_HSTS_SECONDS=0
DJANGO_SECURE_SSL_REDIRECT=True

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=CHANGE_ME

# Where the app listens on the host. 127.0.0.1 when a reverse proxy on this
# machine terminates TLS; 0.0.0.0 only if a load balancer elsewhere reaches
# this port directly.
APP_BIND=127.0.0.1
APP_PORT=5010

GUNICORN_WORKERS=3
GUNICORN_THREADS=4
CELERY_CONCURRENCY=4

# Failed-login lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Push notifications (E8-S5) --------------------------------------------
# Firebase Cloud Messaging reaches iOS, Android and web push through one
# integration, so this is a single credential rather than one per platform.
# "mock" delivers nothing and is the default — the product runs without a
# Firebase project.
PUSH_PROVIDER=mock
# The release switch. Read the warning above the flag in settings/base.py
# before turning it on: a user with in-app notifications off has no row, and
# reminder idempotency lives on that row.
PUSH_ENABLED=false
# Firebase console -> Project settings -> Service accounts -> Generate key.
# Either a path (servers with a mounted secret) or the JSON inline (platforms
# that only have environment variables). Set one, not both.
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=

